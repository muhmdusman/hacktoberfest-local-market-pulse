# Copy to .env.local and fill in values. .env.local is git-ignored.

# ---- Postgres (Docker) ----
POSTGRES_USER=hacktober
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hacktober
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Backend ----
DATABASE_URL=postgresql+asyncpg://hacktober:change_me@localhost:5432/hacktober
DB_ECHO=false
LOG_LEVEL=INFO

APP_NAME=Hacktober API
APP_ENV=local
API_V1_PREFIX=/api/v1

# ---- LLM (open-weight, <= 8B; enforced by app/llm/registry.py) ----
GROQ_API_KEY=your-groq-key-here
LLM_MODEL=allam-2-7b
LLM_MAX_CONCURRENCY=4
LLM_MAX_RETRIES=3
